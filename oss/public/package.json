{
  "name": "mabinogi-mobile-mml-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source Mabinogi Mobile MML parsing, provenance, arrangement analysis, validation, and Studio tooling.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "audit:public": "node scripts/audit-oss-export.mjs .",
    "test": "node scripts/run-public-tests.mjs",
    "test:studio": "node scripts/run-public-tests.mjs --studio",
    "canonical:info": "node -e \"const c=require('./canonical/published.json'); console.log(JSON.stringify(c.metadata,null,2))\"",
    "build": "node scripts/build-studio-web.mjs",
    "preview": "node scripts/serve-studio-web.mjs",
    "test:browser": "node studio/browser-tests/run.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "5.10.1",
    "spessasynth_core": "4.3.16",
    "spessasynth_lib": "4.3.12"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
