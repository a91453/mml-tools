{
  "name": "mml-workbench",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "dependencies": {
    "fast-xml-parser": "5.10.1",
    "spessasynth_core": "4.3.16",
    "spessasynth_lib": "4.3.12"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs studio/tests/*.test.mjs",
    "test:ci": "node --test --test-reporter=./scripts/test-reporter-ci.mjs tests/*.test.mjs studio/tests/*.test.mjs",
    "test:legacy": "node --test tests/*.test.mjs",
    "test:studio": "node --test studio/tests/*.test.mjs",
    "canonical:bootstrap": "node scripts/bootstrap-canonical.mjs",
    "build": "node scripts/build.mjs",
    "build:studio-web": "node scripts/build-studio-web.mjs",
    "preview:studio-web": "node scripts/serve-studio-web.mjs",
    "test:studio-web": "node studio/browser-tests/run.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
