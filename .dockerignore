# Allowlist. Everything is excluded, then exactly what the service needs is
# re-included, so a new file in the repository never silently enters the image.
*

!package.json

# The legacy core the original technical tools run on.
!dist/
dist/*
!dist/core.js

# Transports.
!server/
server/*
!server/mcp.mjs
!server/mcp-studio.mjs
!server/report-page.mjs
!server/studio-web.mjs
!server/api.mjs
!railway/
railway/*
!railway/Dockerfile
!railway/auth.mjs
!railway/server.mjs
!railway/canonical-probe.sh

# The Canonical-aware Studio backend the Application Service orchestrates.
# Tests, fixtures, the local browser engine and the audio worker stay out.
# Only the four HTTP service workspace assets below join the backend image.
!studio/
studio/*
!studio/backend/
!studio/web/
studio/web/*
!studio/web/service/
studio/web/service/*
!studio/web/service/index.html
!studio/web/service/style.css
!studio/web/service/client.mjs
!studio/web/service/app.mjs

# The build-time step that makes the published history available. Railway's
# GitHub source snapshot carries no `.git`, so the image builds the object store
# from the published GitHub repository instead; this is the entry point that
# does it, and the build fails if it cannot.
!scripts/
scripts/*
!scripts/materialize-canonical.mjs

# Still admitted, and no longer depended on. When a build context does carry the
# repository metadata, its checkout identity is kept; the published discovery ref
# is established by the materialization step above either way, so what the image
# loads never depends on whether this was present. Without a proven load the
# service reports CANONICAL_NOT_LOADED -- the honest answer -- and the build gate
# refuses to ship it.
!.git/
